# ---------------------------------------------------------------------------
# Redis (Upstash)
# Set EITHER (a) KV_REST_API_URL + KV_REST_API_TOKEN (auto-populated when
# you link the dunamis-studios-kv integration in Vercel) OR (b) REDIS_URL
# against a self-hosted Redis. The app prefers (a) when both are set.
# ---------------------------------------------------------------------------
REDIS_URL=
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ---------------------------------------------------------------------------
# Session signing. Generate with: openssl rand -base64 48
# Must be at least 32 chars. Rotating invalidates all active sessions.
# ---------------------------------------------------------------------------
JWT_SECRET=

# ---------------------------------------------------------------------------
# KB rating IP-hash salt. SHA-256 over the IP address uses this salt so
# per-article vote dedup can't be reversed to the source IP.
# Generate once: openssl rand -hex 32
# Rotating resets every article's dedup state (already-voted counter).
# ---------------------------------------------------------------------------
KB_RATING_SALT=

# ---------------------------------------------------------------------------
# Resend transactional email
# ---------------------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=hello@dunamisstudios.net

# Optional override for the admin notification recipient on the
# /api/atelier-buy-request route. Falls back to RESEND_FROM_EMAIL
# when unset so production never silently swallows a buy-request lead.
ATELIER_ADMIN_EMAIL=

# ---------------------------------------------------------------------------
# Atelier license signing
# ---------------------------------------------------------------------------
# PEM-encoded Ed25519 private key for signing Atelier license payloads.
# Required by /api/admin/sign-license and /api/admin/issue-license.
# The matching public key is embedded as a constant in
# Software Projects/atelier/src-tauri/src/services/licensing/public_key.rs
# and verifies licenses offline at activation time.
#
# Vercel: provision in Production, Preview, and Development. Newlines
# in the PEM may be encoded as literal "\n" by Vercel's UI — the
# loader normalizes both forms.
ATELIER_LICENSE_SIGNING_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# Stripe. Provision both a webhook secret AND a server-side secret key.
# STRIPE_MODE selects live vs test keyset (defaults to test).
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY is safe to expose client-side.
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_MODE=test
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Property Pulse one-time license price ID. $49 per portal. Read by
# getPropertyPulseLicensePriceId() to build Stripe Checkout sessions
# from /api/stripe/create-one-time-checkout. The Stripe webhook endpoint
# must subscribe to `checkout.session.completed` for purchase ingestion
# (charge.refunded is already subscribed for the refund path).
STRIPE_PRICE_PROPERTY_PULSE_LICENSE=

# ---------------------------------------------------------------------------
# Base URL for email links, cookie scope, etc.
# ---------------------------------------------------------------------------
APP_URL=https://dunamisstudios.net

# ---------------------------------------------------------------------------
# HMAC-SHA256 secret for verifying the install-handoff state token that
# Property Pulse / Debrief pass when a user installs the app in HubSpot.
# The product server signs the token with this same secret; any mismatch
# fails every claim with "signature mismatch" and blocks new installs from
# linking their account here.
#
# Generate once: openssl rand -hex 32
# Set the SAME value in this project's Vercel env AND in each product
# repo's Vercel env (CLAIM_STATE_SECRET). Rotating this invalidates all
# in-flight claim links (15-minute TTL anyway, so low blast radius), but
# must be done across all three projects in lockstep.
# ---------------------------------------------------------------------------
CLAIM_STATE_SECRET=

# ---------------------------------------------------------------------------
# HubSpot private-app access token for the Dunamis Studios CRM portal
# (portal 20867488). Used server-side to send custom event occurrences to
# /events/v3/send and to upsert contact properties for account activity,
# install/uninstall, billing, and terms acceptance tracking.
#
# Create at HubSpot → Settings → Integrations → Private Apps. Required
# scopes:
#   - crm.objects.contacts.read
#   - crm.objects.contacts.write
#   - crm.schemas.contacts.read
#   - behavioral_events.event_definitions.read_write (read/define events)
#   - analytics.behavioral_events.send (send event occurrences via
#     POST /events/v3/send, NOT covered by the event_definitions scope;
#     missing this returns HTTP 403 on every send)
#
# NEVER prefix with NEXT_PUBLIC_; the token is secret. src/lib/hubspot/*
# modules import "server-only" to enforce this at build time.
# ---------------------------------------------------------------------------
HUBSPOT_ACCESS_TOKEN=

# ---------------------------------------------------------------------------
# HubSpot Notify Interests form. Mirrored from /api/notify so visitor
# signups appear as contacts in the Dunamis Studios portal with the
# product display name appended to the multi-select notify_interests
# property. Both values are public identifiers (the portal ID is in
# every embedded form snippet, and form GUIDs are not secret), but they
# stay in env so we can move the form between portals or rotate the
# GUID without a redeploy. The submission endpoint
# https://api.hsforms.com/submissions/v3/integration/submit/{portal}/{guid}
# is unauthenticated; the contact lookup that precedes it uses the same
# HUBSPOT_ACCESS_TOKEN above.
# ---------------------------------------------------------------------------
HUBSPOT_PORTAL_ID=
HUBSPOT_NOTIFY_FORM_GUID=

# ---------------------------------------------------------------------------
# HubSpot "Free Tools - Lead Capture" form. Mirrored from every /tools/*
# email-capture surface (handoff time calculator, future tools). Form
# fields: First Name, Last Name, Email (required), Company Name, plus a
# hidden single-line text field "Free Tool Used" (internal name
# free_tool_used) carrying the tool's display name so segmentation in
# HubSpot can route by tool. Submitter lives in src/lib/hubspot-free-
# tools-form.ts; current callers send only email + tool name, but the
# helper accepts firstname/lastname/company for tools that collect more.
# Form GUID is a public identifier (visible in HubSpot's URL when
# editing the form); kept in env so the form can be rotated without a
# redeploy.
# ---------------------------------------------------------------------------
HUBSPOT_FREE_TOOLS_FORM_GUID=d4417abd-b1db-429b-b000-637f572638b7

# ---------------------------------------------------------------------------
# HubSpot "Email Courses - Signup" form. Mirrored from /api/courses/signup
# so visitors that subscribe to a free email course (e.g. the 5-Day HubSpot
# Audit) appear as contacts in the Dunamis Studios portal. Form fields:
# First Name, Last Name (optional), Email (required), plus a hidden
# single-line text field "Course Name" (internal name course_name)
# carrying the course's display name so HubSpot workflows can branch on
# which course to drip. The site does not send the drip emails itself;
# the HubSpot workflow is the sender. Submitter lives in
# src/lib/hubspot-courses-form.ts. Form GUID is a public identifier
# (visible in HubSpot's URL when editing the form); kept in env so the
# form can be rotated without a redeploy.
# ---------------------------------------------------------------------------
HUBSPOT_COURSES_FORM_GUID=

# ---------------------------------------------------------------------------
# HubSpot "Custom Development Contact" form. Powers /contact and the
# inline contact surfaces on /custom-development and /build-services.
# Same unauthenticated submissions endpoint as the other public-facing
# HubSpot forms; the visitor never sends a request to HubSpot directly,
# so the GUID is read server-side and not exposed to the client. Form
# fields: First Name, Last Name, Email, Company, "What are you trying
# to solve?", Budget Range, Timeline. Submitter lives in
# src/app/api/contact-submit/route.ts. Previously the portal id and
# GUID were inline constants in the route; moved to env so the form
# can be rotated without a redeploy and to match the rest of the
# HubSpot form config.
# ---------------------------------------------------------------------------
HUBSPOT_CONTACT_FORM_GUID=cfda52bd-4573-4e7e-9057-68d2aea2a10a

# ---------------------------------------------------------------------------
# HubSpot "Customer Support" form. Powers /help/contact-support. The
# form on HubSpot's side is wired to a Help Desk pipeline so each
# submission opens a ticket. Conditional fields on the form mirror the
# React component's conditional logic (Category drives which optional
# fields are required when shown). Submitter lives in
# src/app/api/support-submit/route.ts. Same unauthenticated v3
# submissions endpoint as the other forms.
# ---------------------------------------------------------------------------
HUBSPOT_SUPPORT_FORM_GUID=9b68c406-7399-448d-97f0-597731cf7de8

# ---------------------------------------------------------------------------
# Verification key secret for the support form's identity check.
# HMAC-SHA256 key used by src/lib/verification-key/service.ts to derive
# the short-lived 32-hex-char keys that customers paste into the
# Verification Key field on /help/contact-support. Rotating the value
# invalidates every in-flight key at redeploy time, which is the
# intended posture for a compromise. Required in production; the
# service throws at module load when this is unset.
#
# Generate with `openssl rand -base64 48` or any other source of 32+
# bytes of unguessable entropy. The secret never leaves the server
# (the derived keys are what reach the wire) so any string with enough
# entropy is fine.
# ---------------------------------------------------------------------------
VERIFICATION_KEY_SECRET=

# ---------------------------------------------------------------------------
# Cloudflare Turnstile (site-wide bot protection on public forms).
#
# Two env vars stack:
#
#   NEXT_PUBLIC_TURNSTILE_SITE_KEY: public widget key, safe to expose
#     client-side. Read by src/components/turnstile-widget.tsx at render
#     time. When unset the widget renders a small "Security check
#     unavailable" placeholder rather than crashing the form, so dev /
#     preview deploys without the key stay functional.
#
#   TURNSTILE_SECRET_KEY: server-only secret used by
#     src/lib/turnstile/verify.ts to POST to Cloudflare's siteverify
#     endpoint. Required in production; the helper throws on first
#     verify call when unset so a missing key fails loud rather than
#     silently waving through every submission.
#
# Provision both from the Cloudflare dashboard
# (Turnstile -> Add site -> Managed widget) and add to Production,
# Preview, AND Development in Vercel so preview deploys can verify
# tokens issued on preview.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---------------------------------------------------------------------------
# Admin access. Comma-separated list of account emails that can access
# /admin routes. Case-insensitive. Example: alice@example.com,bob@example.com
# ---------------------------------------------------------------------------
ADMIN_EMAILS=

# ---------------------------------------------------------------------------
# Rate limiting kill-switch for the public Atelier endpoints (activation,
# heartbeat, EULA acceptance). Set to "1" to bypass the @upstash/ratelimit
# checks in src/lib/ratelimit.ts (smoke scripts, local debugging, incident
# rollback). Unset / any other value applies the limiters normally.
# Production should leave this empty.
# ---------------------------------------------------------------------------
RATE_LIMIT_DISABLED=

NODE_ENV=production
