# Project-specific ignores only.
# Universal ignores (node_modules, .env*, logs, OS junk, editor/agent files,
# .vercel, coverage, generic build outputs) live in ~/.gitignore_global —
# see Hubspot Development - Personal/CLAUDE.md §12.

# Dependencies
node_modules/

# Next.js
.next/
next-env.d.ts.backup

# TypeScript
*.tsbuildinfo

# PEM / certs — Next's default scaffold ignores these; keeping project-local
# since PEMs aren't universal ignore-territory.
*.pem

.vercel
.env*.local

# CRON_SECRET sidecar read by scripts/smoke-cron-rerun.ts. Vercel's
# Sensitive env vars come down empty from `vercel env pull`, so the
# secret lives in a local-only sidecar file. Never commit.
.env.local.cron

# Unlighthouse audit output. Local tool run; outputs are large and
# don't belong in the repo.
.unlighthouse/

# Build artifact: scripts/build-kb-index.ts writes this on prebuild
# from content/kb/**/*.md, consumed at runtime by the help-page
# SearchBox via fetch. Regenerated on every Vercel deploy.
public/kb-index.json

# Internal audit drafts kept alongside the docs they audit. The leading
# underscore + date stamp is the convention; published docs never start
# with "_".
content/atelier-docs/_audit-*.md
content/kb/**/_audit-*.md

# Internal docs / scratch / checklists. Same convention as the other
# repos in this tree (atelier, HubSpot projects). Anything under
# docs/internal/ stays local; checklists, post-launch backlogs, audit
# notes, etc., do not need to live in version control.
docs/internal/
